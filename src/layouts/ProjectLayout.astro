---
import BaseLayout from './BaseLayout.astro';
import IconDownload from '../components/icons/IconDownload.astro';
import IconCode from '../components/icons/IconCode.astro';
import IconTags from '../components/icons/IconTags.astro';
import IconPencil from '../components/icons/IconPencil.astro';

interface Props {
  title: string;
  authors?: string[];
  authorsUrl?: string[];
  tags?: string[];
  archive?: string;
  nosource?: boolean;
  path?: string;
}

const { title, authors, authorsUrl, tags, archive, nosource, path } = Astro.props;
const base = import.meta.env.BASE_URL;
const sourceUrl = 'https://github.com/ff6347/gestalten-in-code/tree/master';

// Calculate paths for archive and source links
const folderPath = path ? path.replace('index.md', '').replace(/^\//, '') : '';
---
<BaseLayout title={title} isProject={true}>
  <section>
    <div id="sub-header">
      {archive && (
        <div class="archive">
          <a href={`${base}${folderPath}${archive}`}><IconDownload /></a>
        </div>
      )}
      {!nosource && path && (
        <div class="source">
          <a href={`${sourceUrl}/${folderPath}`}><IconCode /></a>
        </div>
      )}
      <h1 id="title">{title}</h1>
      <div class="clear-float"></div>
      {tags && tags.length > 0 && (
        <div class="page-tags font_small">
          <IconTags />
          {tags.map((tag, index) => (
            <span>{tag}{index < tags.length - 1 ? ', ' : ''}</span>
          ))}
        </div>
      )}
      {authors && authors.length > 0 && (
        <div class="author font_small">
          <IconPencil />
          {authors.map((author, index) => (
            <span>
              {authorsUrl && authorsUrl[index] ? (
                <a href={authorsUrl[index]}>{author}</a>
              ) : (
                author
              )}
              {index < authors.length - 1 ? ', ' : ''}
            </span>
          ))}
        </div>
      )}
    </div>
  </section>
  <section>
    <div id="main" class="project">
      <slot />
    </div>
  </section>
</BaseLayout>
