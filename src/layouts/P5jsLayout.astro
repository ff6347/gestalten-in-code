---
import DefaultLayout from './DefaultLayout.astro';
import { Code } from 'astro:components';

interface Props {
  title: string;
  author?: string;
  authorUrl?: string;
  tags?: string[];
  archive?: string;
  nosource?: boolean;
  path?: string;
  summary?: string;
  jsCode?: string;
}

const { title, author, authorUrl, tags, archive, nosource, path, summary, jsCode } = Astro.props;
const base = import.meta.env.BASE_URL;

// Calculate the script path from the page path
const scriptPath = path ? path.replace('.md', '.js').replace(/^\//, '') : '';
---
<DefaultLayout
  title={title}
  author={author}
  authorUrl={authorUrl}
  tags={tags}
  archive={archive}
  nosource={nosource}
  path={path}
>
  <div id="sketch"></div>
  {summary && <div class="hero">{summary}</div>}
  <slot />

  {jsCode && (
    <Code code={jsCode} lang="js" theme="github-light" />
  )}

  <script is:inline src={`${base}assets/js/p5.min.js`}></script>
  <script is:inline src={`${base}${scriptPath}`}></script>
</DefaultLayout>
