---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import Overview from '../../components/Overview.astro';

const summary = "Objects that are arranged in a line or curve are perceived as being more related than objects not arranged in a line or curve.";
---
<DefaultLayout title="Law of Continuity" nosource={true}>
  <div class="hero">{summary}</div>
  <Overview param="Law of Continuity" />
</DefaultLayout>
